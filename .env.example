# CricketPro Environment Configuration
# Copy this file to .env before running the app locally.

# Database Configuration
DATABASE_URL="postgresql://cricketpro:cricketpro@localhost:5432/cricketpro?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=3000

# JWT Configuration
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"

# Multi-Tenant Configuration
DEFAULT_TENANT_ID="tenant_123"
